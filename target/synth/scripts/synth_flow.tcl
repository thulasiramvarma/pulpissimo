## Cadence Genus Synthesis Flow
## Three-stage: syn_generic → syn_map → syn_opt
## Run: genus -f synth_flow.tcl -define BLOCK=<block>
##
## Source list generated by Bender:
##   bender script genus -t asic -t synthesis > scripts/bender_sources.tcl

set SCRIPT_DIR [file dirname [info script]]

# ---- Step 1: Setup and MMMC ----
source $SCRIPT_DIR/mmmc.tcl
puts "\[synth\] Starting synthesis for block: $BLOCK"

# ---- Step 2: Read HDL (Bender-generated file list) ----
puts "\[synth\] Reading HDL sources..."
source $SCRIPT_DIR/bender_sources.tcl

# Block-specific top module
set TOP_MAP(fc)               fc_subsystem
set TOP_MAP(aes256)           aes256_top
set TOP_MAP(sha256)           sha256_top
set TOP_MAP(ecc521)           ecc521_top
set TOP_MAP(kyber)            kyber_top
set TOP_MAP(trng)             trng_top
set TOP_MAP(otp_ctrl)         otp_ctrl_top
set TOP_MAP(crypto_subsystem) crypto_subsystem_top
set TOP_MAP(pulp_soc)         pulp_soc
set TOP_MAP(pulpissimo)       pulpissimo

if {![info exists TOP_MAP($BLOCK)]} {
  error "\[synth\] Unknown block: $BLOCK. Valid: [array names TOP_MAP]"
}
set TOP_MODULE $TOP_MAP($BLOCK)

# ---- Step 3: Elaborate ----
puts "\[synth\] Elaborating $TOP_MODULE..."
elaborate $TOP_MODULE

# Apply MMMC after elaboration
init_design -top $TOP_MODULE

# ---- Step 4: syn_generic (technology-independent optimization) ----
puts "\[synth\] syn_generic..."
syn_generic

report_qor > $REPORT_DIR/${BLOCK}_qor_generic.rpt
report_timing -nworst 10 > $REPORT_DIR/${BLOCK}_timing_generic.rpt

# ---- Step 5: syn_map (map to standard cells) ----
puts "\[synth\] syn_map..."
syn_map

report_qor > $REPORT_DIR/${BLOCK}_qor_map.rpt
report_timing -nworst 10 > $REPORT_DIR/${BLOCK}_timing_map.rpt
report_area > $REPORT_DIR/${BLOCK}_area_map.rpt

# ---- Step 6: syn_opt (post-map optimization) ----
puts "\[synth\] syn_opt..."
syn_opt

# ---- Step 7: Reports ----
puts "\[synth\] Writing final reports..."
report_qor               > $REPORT_DIR/${BLOCK}_qor_final.rpt
report_timing -nworst 20 > $REPORT_DIR/${BLOCK}_timing_final.rpt
report_area              > $REPORT_DIR/${BLOCK}_area_final.rpt
report_power             > $REPORT_DIR/${BLOCK}_power_final.rpt
report_cell              > $REPORT_DIR/${BLOCK}_cells.rpt

# Multicycle path check
report_timing -check_type setup -view setup_view -nworst 5 \
  > $REPORT_DIR/${BLOCK}_setup_paths.rpt
report_timing -check_type hold -view hold_view -nworst 5 \
  > $REPORT_DIR/${BLOCK}_hold_paths.rpt

# ---- Step 8: Write outputs ----
puts "\[synth\] Writing netlist and constraints..."
file mkdir $NETLIST_DIR

write_hdl > $NETLIST_DIR/${BLOCK}_netlist.v
write_sdf -version 3.0 > $NETLIST_DIR/${BLOCK}.sdf
write_sdc > $NETLIST_DIR/${BLOCK}.sdc
write_db  $NETLIST_DIR/${BLOCK}.db

puts "\[synth\] COMPLETE: $BLOCK"
puts "\[synth\] Netlist : $NETLIST_DIR/${BLOCK}_netlist.v"
puts "\[synth\] Reports : $REPORT_DIR/"
